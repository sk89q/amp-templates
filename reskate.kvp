Meta.DisplayName=ReSkate
Meta.Description=ReSkate Dedicated Server (fan multiplayer for skate.)
Meta.OS=Windows
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=Local template
Meta.URL=https://github.com/Dingo-Shenanigans/ReSkate
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/sk89q/amp-templates/main/reskate.jpg
Meta.EndpointURIFormat=
Meta.ConfigManifest=reskateconfig.json
Meta.MetaConfigManifest=reskatemetaconfig.json
Meta.ConfigRoot=reskate.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=2
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=106a12e7-3a42-46b0-8737-a9fcfb7167e6
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=ReSkate
App.RootDir=./reskate/
App.BaseDirectory=./reskate/
App.ExecutableWin=ReSkateServer.exe
App.ExecutableLinux=
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=--headless --no-update --config ReSkateServer.json
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=--{0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ApplicationIPBinding=0.0.0.0
App.UDPLogger=False
App.ForceIPBinding=False
App.Ports=@IncludeJson[reskateports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=16
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=30
App.RCONConnectRetrySeconds=15
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.IgnoreSTDOUTAfterRCON=False
App.TelnetLoginFormat={0}
App.PreStartStages=[]
App.UpdateSources=@IncludeJson[reskateupdates.json]
App.ForceUpdate=False
App.ForceUpdateReason=
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.SteamWorkshopDownloadLocation=
App.RapidStartup=False
App.Compatibility=None
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.MonitorChildProcess=False
App.MonitorDirectChildOnly=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessWaitMs=1000
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^$
Console.AppReadyRegex=^(?:\[\d{1,2}:\d{2}:\d{2}(?: ?[AaPp][Mm])?\] )?(?!\[).+ is up on .+ for \d+ players?\.$
Console.UserJoinRegex=^(?:\[\d{1,2}:\d{2}:\d{2}(?: ?[AaPp][Mm])?\] )?(?!\[)(?<username>.+?) joined \((?<userid>\d+).*$
Console.UserLeaveRegex=^(?:\[\d{1,2}:\d{2}:\d{2}(?: ?[AaPp][Mm])?\] )?(?!\[)(?<username>.+?) left \(.*$
Console.UserChatRegex=^(?:\[\d{1,2}:\d{2}:\d{2}(?: ?[AaPp][Mm])?\] )?\[chat\] (?!Server: )(?<username>.+?): (?<message>.+)$
Console.UpdateAvailableRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
